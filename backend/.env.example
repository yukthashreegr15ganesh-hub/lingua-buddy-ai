# LINGUA BUDDY AI - Server-Side AI Configuration
# Copy this file to .env and add your API key to enable live Cloud LLM responses.
# When left blank, Lingua Buddy AI runs in Built-in Multilingual Tutor Mode (Local Fallback).

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
